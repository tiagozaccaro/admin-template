# MCP environment example (safe to commit)

# Copy to .env.mcp.local and fill in real values. Never commit .env.mcp.local.
# chmod 600 .env.mcp.local

# Context7 documentation MCP (optional higher rate limits)
CONTEXT7_API_KEY=

# GitHub MCP read-only (fine-grained PAT, repo read)
MCP_GITHUB_PAT=

# PostgreSQL read-only MCP (read-only database URL)
MCP_POSTGRES_URL=
