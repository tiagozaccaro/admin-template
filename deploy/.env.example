# Admin Template self-hosted environment (development)
# Copy to deploy/.env and adjust as needed:
#   cp deploy/.env.example deploy/.env
#   docker compose --env-file deploy/.env -f deploy/docker-compose.yml up -d --build

# --- PostgreSQL (source of truth) ---
POSTGRES_USER=admin-template
POSTGRES_PASSWORD=admin-template
POSTGRES_DB=admin-template

# --- Redis (cache + sessions) ---
REDIS_URL=redis://redis:6379/0

# --- Keycloak (OIDC) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/admin-template/protocol/openid-connect/certs
KEYCLOAK_ISSUER=http://keycloak:8080/realms/admin-template

# --- API (derived when running via docker compose) ---
# DATABASE_URL=postgresql+asyncpg://admin-template:admin-template@postgres:5432/admin-template
