# Admin Template self-hosted environment (development)
# Copy to deploy/.env and adjust as needed:
#   cp deploy/.env.example deploy/.env
#   docker compose --env-file deploy/.env -f deploy/docker-compose.yml up -d --build

# --- PostgreSQL (source of truth) ---
POSTGRES_USER=contentforge
POSTGRES_PASSWORD=contentforge
POSTGRES_DB=contentforge

# --- Redis (queue + cache + sessions) ---
REDIS_URL=redis://redis:6379/0

# --- MinIO (S3-compatible object storage, dev profile) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Keycloak (OIDC) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/contentforge/protocol/openid-connect/certs
KEYCLOAK_ISSUER=http://keycloak:8080/realms/contentforge

# --- API (derived when running via docker compose) ---
# DATABASE_URL=postgresql+asyncpg://contentforge:contentforge@postgres:5432/contentforge
