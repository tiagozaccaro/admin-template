// Kilo Code project-level MCP configuration.
// See https://kilo.ai/docs/automate/mcp/using-in-kilo-code
// Secrets are NOT stored here. Use {env:VAR} references and set values in
// .env.mcp.local (gitignored) or your shell environment before launching Kilo.
{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@0.0.83", "--headless"],
      "enabled": false,
      "timeout": 15000
    },
    "next-devtools": {
      "type": "local",
      "command": ["npx", "-y", "next-devtools-mcp@0.4.0"],
      "enabled": true,
      "timeout": 15000
    },
    "dart": {
      "type": "local",
      "command": ["dart", "mcp-server"],
      "enabled": false,
      "timeout": 10000
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true,
      "timeout": 10000
    }
  }
}
