# Admin Template — Docker build context exclusions for the API image.
# The context is apps/api, so the root .dockerignore does not apply here.

# Virtual environments (the local one holds macOS binaries)
.venv/
venv/

# Python caches
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Environment / secrets
.env
.env.*
*.log
*.log*

# Node and build output that leaked into this workspace
node_modules/
.turbo/

# Version control
.git/

# Universal
.DS_Store
Thumbs.db
*.swp
*.swo
*~
