{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "install: js dependencies",
      "type": "shell",
      "command": "pnpm",
      "args": ["install"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "install: api dependencies",
      "type": "shell",
      "command": "uv",
      "args": ["sync"],
      "options": {
        "cwd": "${workspaceFolder}/apps/api"
      },
      "problemMatcher": []
    },
    {
      "label": "install: agent dependencies",
      "type": "shell",
      "command": "uv",
      "args": ["sync"],
      "options": {
        "cwd": "${workspaceFolder}/apps/agent"
      },
      "problemMatcher": []
    },
    {
      "label": "install: mobile dependencies",
      "type": "shell",
      "command": "flutter",
      "args": ["pub", "get"],
      "options": {
        "cwd": "${workspaceFolder}/apps/mobile"
      },
      "problemMatcher": []
    },
    {
      "label": "prepare: all dependencies",
      "dependsOn": [
        "install: js dependencies",
        "install: api dependencies",
        "install: mobile dependencies"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
