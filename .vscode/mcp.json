{
  "inputs": [
    {
      "id": "github_pat",
      "description": "GitHub fine-grained personal access token (read-only, repo-scoped). Create at github.com/settings/tokens/personal-access-tokens/fine-grained. Never hardcode.",
      "password": true,
      "type": "promptString"
    },
    {
      "id": "postgres_url",
      "description": "Local PostgreSQL dev connection URL, e.g. postgresql://tiago@localhost:5432/postgres. Use a read-only role. Never hardcode credentials.",
      "password": true,
      "type": "promptString"
    }
  ],
  "servers": {
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@4.4.2"
      ]
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--headless"
      ]
    },
    "next-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "next-devtools-mcp@0.4.0"
      ]
    },
    "dart": {
      "type": "stdio",
      "command": "dart",
      "args": [
        "mcp-server"
      ]
    },
    "postgres": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "pg-ro-mcp@0.1.0",
        "--database-url",
        "${input:postgres_url}"
      ]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/readonly",
      "headers": {
        "Authorization": "Bearer ${input:github_pat}",
        "X-MCP-Readonly": "true",
        "X-MCP-Toolsets": "repos,issues,pull_requests"
      }
    }
  }
}
