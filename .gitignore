# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production
build
dist

# turbo
.turbo
apps/**/.turbo
packages/**/.turbo

# pnpm
pnpm-workspace-state-v1.json
node_modules/.package-map.json
node_modules/.modules.yaml

# python
apps/api/.venv
apps/api/uv.lock
*.pyc
__pycache__
.pytest_cache
.mypy_cache
.ruff_cache

# kilo
.kilo/agent-manager.json

# spec kit
.specify/.gitignore

# misc
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Deployed environment example is safe to commit (copy to deploy/.env locally)
!deploy/.env.example
# MCP local secrets - never commit
.env.mcp.local
# Sanitized MCP example is safe to commit
!.env.mcp.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
